layout {
	background-color "#0a151a"

    focus-ring {
        active-color "#889299"
        inactive-color "#889299"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#889299"
        inactive-color "#b0c6f9"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#889299"
        inactive-color "#b0c6f9"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#6fd2ff80"
    }
}

overview {
	backdrop-color "#0a151a"
}

recent-windows {
    highlight {
        active-color "#6fd2ff"
        urgent-color "#ffb4ab"
    }
}
