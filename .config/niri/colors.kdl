layout {
	background-color "#0f131c"

    focus-ring {
        active-color "#8c919c"
        inactive-color "#8c919c"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#8c919c"
        inactive-color "#c9bff8"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#8c919c"
        inactive-color "#c9bff8"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#aac7ff80"
    }
}

overview {
	backdrop-color "#0f131c"
}

recent-windows {
    highlight {
        active-color "#aac7ff"
        urgent-color "#ffb4ab"
    }
}
