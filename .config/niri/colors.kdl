layout {
	background-color "#131412"

    focus-ring {
        active-color "#bfcab7"
        inactive-color "#a09f9c"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#bfcab7"
        inactive-color "#a09f9c"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#bfcab7"
        inactive-color "#a09f9c"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#bfcab780"
    }
}

overview {
	backdrop-color "#131412"
}

recent-windows {
    highlight {
        active-color "#bfcab7"
        urgent-color "#ffb4ab"
    }
}
