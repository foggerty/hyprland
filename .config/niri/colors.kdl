layout {
	background-color "#101418"

    focus-ring {
        active-color "#ebf0f8"
        inactive-color "#ebf0f8"
        urgent-color   "#ffece9"
    }

    border {
        active-color   "#ebf0f8"
        inactive-color "#f7ecff"
        urgent-color   "#ffece9"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#ebf0f8"
        inactive-color "#f7ecff"
        urgent-color   "#ffece9"
    }

    insert-hint {
        color "#e6f1ff80"
    }
}

overview {
	backdrop-color "#101418"
}

recent-windows {
    highlight {
        active-color "#e6f1ff"
        urgent-color "#ffece9"
    }
}
