layout {
	background-color "#0f150b"

    focus-ring {
        active-color "#8c9383"
        inactive-color "#8c9383"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#8c9383"
        inactive-color "#96d4b4"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#8c9383"
        inactive-color "#96d4b4"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#72e00080"
    }
}

overview {
	backdrop-color "#0f150b"
}

recent-windows {
    highlight {
        active-color "#72e000"
        urgent-color "#ffb4ab"
    }
}
