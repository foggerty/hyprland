layout {
	background-color "#091517"

    focus-ring {
        active-color "#869396"
        inactive-color "#869396"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#869396"
        inactive-color "#a0cbf2"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#869396"
        inactive-color "#a0cbf2"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#00daf280"
    }
}

overview {
	backdrop-color "#091517"
}

recent-windows {
    highlight {
        active-color "#00daf2"
        urgent-color "#ffb4ab"
    }
}
