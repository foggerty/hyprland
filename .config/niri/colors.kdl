layout {
	background-color "#0e150c"

    focus-ring {
        active-color "#8b9385"
        inactive-color "#8b9385"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#8b9385"
        inactive-color "#92d4bb"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#8b9385"
        inactive-color "#92d4bb"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#00e60880"
    }
}

overview {
	backdrop-color "#0e150c"
}

recent-windows {
    highlight {
        active-color "#00e608"
        urgent-color "#ffb4ab"
    }
}
